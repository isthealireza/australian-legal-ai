# Local development only. Never use these values in production.
POSTGRES_USER=legal_ai
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=legal_ai
POSTGRES_PORT=5432

# Supply explicit URLs only in the local environment that runs migrations or tests.
LEGAL_AI_DATABASE_URL=
LEGAL_AI_TEST_DATABASE_URL=

# Optional local-only external review gate configuration. Keep values blank.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# Read-only research API (ADR 0014, ADR 0015). Paths are relative to the repo.
LEGAL_AI_WA_CORPUS_ROOT=
LEGAL_AI_PROVISION_ROOT=
LEGAL_AI_RESEARCH_AUDIT_LOG=
LEGAL_AI_STATIC_DIR=

# Provider chain. A credential alone never switches on a live provider:
# LEGAL_AI_ANSWER_PROVIDER must be set explicitly ("mock", "openrouter"
# or "deepseek"). Each provider reads its own key from its own variable.
LEGAL_AI_ANSWER_PROVIDER=mock
LEGAL_AI_ANSWER_MODEL=
LEGAL_AI_FALLBACK_PROVIDER=
LEGAL_AI_FALLBACK_MODEL=
LEGAL_AI_FINAL_FALLBACK_PROVIDER=
LEGAL_AI_FINAL_FALLBACK_MODEL=

# Entailment verification. Defaults to a provider other than the one that
# answered, so a model is never the proof of its own output.
LEGAL_AI_VERIFY_PROVIDER=
LEGAL_AI_VERIFY_MODEL=
LEGAL_AI_VERIFY_ENTAILMENT=

# Live provider configuration. Keep values blank here; put real keys only in
# .env.local, which is never committed.
OPENROUTER_API_KEY=
LEGAL_AI_OPENROUTER_MODEL=
LEGAL_AI_OPENROUTER_BASE_URL=
